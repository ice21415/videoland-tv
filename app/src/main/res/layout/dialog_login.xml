<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_normal" android:padding="22dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_title" android:textColor="@color/brand_gold" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="選擇你原本使用的登入方式" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="#1B1E26" android:orientation="vertical" android:padding="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Google 帳號" android:textColor="@color/brand_gold" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:lineSpacingExtra="2dp" android:text="透過電視上的 TV Bro 瀏覽器登入 Google。長按確認鍵可切換直接導覽模式。" android:textColor="@color/text_secondary" android:textSize="11sp" />
            <Button android:id="@+id/btn_google_login" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="12dp" android:background="@drawable/bg_btn_selector" android:focusable="true" android:text="使用 Google 登入" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" android:textAllCaps="false" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="會員密碼與 Google 密碼不同，請依原本的登入方式繼續。" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" />
        <EditText android:id="@+id/et_username" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="#2E3342" android:focusable="true" android:hint="請輸入緯來會員帳號或信箱" android:inputType="textEmailAddress" android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="14sp" />
        <EditText android:id="@+id/et_password" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="#2E3342" android:focusable="true" android:hint="@string/hint_password" android:inputType="textPassword" android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="14sp" />
        <TextView android:id="@+id/tv_login_msg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/status_live" android:textSize="12sp" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="end" android:orientation="horizontal">
            <Button android:id="@+id/btn_dialog_cancel" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_tab_selector" android:focusable="true" android:paddingHorizontal="20dp" android:text="@string/btn_cancel" android:textColor="@color/text_secondary" android:textSize="13sp" />
            <Button android:id="@+id/btn_dialog_login" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/bg_btn_selector" android:focusable="true" android:paddingHorizontal="24dp" android:text="以會員帳密登入" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>