<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark" android:orientation="vertical" android:padding="26dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingBottom="12dp">
        <ImageView android:id="@+id/iv_logo" android:layout_width="140dp" android:layout_height="40dp" android:contentDescription="@string/app_name" android:scaleType="fitStart" android:src="@drawable/tv_banner" />
        <TextView android:id="@+id/tv_app_subtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="體育賽事 · 非官方電視版" android:textColor="@color/text_secondary" android:textSize="14sp" />
        <TextView android:id="@+id/tv_user_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:background="@color/bg_dark" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="@string/user_guest" android:textColor="@color/brand_gold" android:textSize="13sp" />
        <Button android:id="@+id/btn_auth" android:layout_width="wrap_content" android:layout_height="42dp" android:background="@drawable/bg_btn_selector" android:focusable="true" android:paddingHorizontal="18dp" android:text="帳號" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
    <HorizontalScrollView android:id="@+id/hsv_tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/tab_schedule" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_tab_selector" android:focusable="true" android:nextFocusDown="@+id/rv_content" android:paddingHorizontal="24dp" android:text="所有賽程" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" />
            <Button android:id="@+id/tab_banners" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_tab_selector" android:focusable="true" android:nextFocusDown="@+id/rv_content" android:paddingHorizontal="24dp" android:text="最近回放" android:textColor="@color/text_primary" android:textSize="15sp" android:textAllCaps="false" />
            <Button android:id="@+id/tab_categories" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_tab_selector" android:focusable="true" android:nextFocusDown="@+id/rv_content" android:paddingHorizontal="24dp" android:text="運動分類" android:textColor="@color/text_primary" android:textSize="15sp" android:textAllCaps="false" />
            <Button android:id="@+id/tab_web" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_tab_selector" android:focusable="true" android:nextFocusDown="@+id/rv_content" android:paddingHorizontal="24dp" android:text="重新整理" android:textColor="@color/text_primary" android:textSize="15sp" android:textAllCaps="false" />
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="4dp" android:layout_marginTop="12dp" android:layout_marginBottom="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_section_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="所有賽事" android:textSize="23sp" android:textStyle="bold" android:textColor="@color/text_primary" />
            <TextView android:id="@+id/tv_section_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="直播、即將開賽與最近五日回放" android:textSize="13sp" android:textColor="@color/text_secondary" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <Button android:id="@+id/btn_clear_filter" android:layout_width="wrap_content" android:layout_height="42dp" android:paddingHorizontal="16dp" android:background="@drawable/bg_tab_selector" android:text="全部運動" android:textColor="@color/text_primary" android:visibility="gone" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_content" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:focusable="false" android:padding="8dp" />
        <ProgressBar android:id="@+id/pb_loading" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center" android:indeterminateTint="@color/brand_gold" android:visibility="gone" />
        <TextView android:id="@+id/tv_empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/status_no_data" android:textColor="@color/text_secondary" android:textSize="16sp" android:visibility="gone" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/btn_retry" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="28dp" android:paddingHorizontal="24dp" android:background="@drawable/bg_btn_selector" android:text="重新載入" android:textColor="@color/bg_dark" android:visibility="gone" />
    </FrameLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="6dp" android:text="方向鍵 選擇　·　確認鍵 開啟　·　返回鍵 上一層" android:textColor="@color/text_secondary" android:textSize="12sp" />
</LinearLayout>